# Copy to .env for local development. Never commit .env.
# On the box, this file lives at /config/.env with mode 0600.

# Mint with `claude setup-token` on a machine where you can complete the browser
# OAuth flow. Valid roughly a year. Rides your existing Claude subscription — no
# API billing. See docs/PHASE-0.md.
CLAUDE_CODE_OAUTH_TOKEN=

# Absolute path to the project a fresh run opens. A project is a directory; the
# in-app picker clones/creates the rest. Locally, point it at a repo on disk.
PROJECT_PATH=

# Optional. Defaults below.
PORT=3000
HOST=127.0.0.1
DB_PATH=./data/events.db
NODE_ENV=development

# Web push (Phase 1). Generate once with: npx web-push generate-vapid-keys --json
# The public key is safe to expose (the client fetches it); the private key is a
# secret. Absent means push is disabled and the server says so at boot.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# A GitHub token (classic `repo` + `read:org`). Enables clone/create + `git push`,
# and the entrypoint derives your git commit identity from it (login + GitHub
# noreply email) so commits attribute to your account. See docs/PHASE-2.md.
GH_TOKEN=

# Optional. Overrides the gh-derived git commit identity above. Leave unset to
# attribute commits to the GH_TOKEN account.
# GIT_AUTHOR_NAME=
# GIT_AUTHOR_EMAIL=
