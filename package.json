{
  "name": "mobile-code-editor",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter workspace-server dev",
    "dev:web": "pnpm --filter web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "//": "node-pty ships no Linux prebuilt binary, so it must compile from source on the CI runner and in the Docker build stage. pnpm v10 blocks dependency build scripts unless allowlisted here.",
    "onlyBuiltDependencies": ["node-pty"]
  }
}
