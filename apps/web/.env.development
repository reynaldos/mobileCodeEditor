# Loaded automatically by `vite dev`, ignored by `vite build`.
#
# In development the client is served by Vite on :5173 and the API lives on
# :3000, so calls are cross-origin. In production the workspace server serves
# this app from its own origin and BASE is empty — which is why there is no CORS
# configuration anywhere outside dev.
VITE_API_BASE=http://localhost:3000
